generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // <-- KEMBALIKAN BARIS INI
}

model MedicalRecord {
  id                String   @id @default(uuid())
  scanId            String   @unique @map("scan_id")
  timestamp         DateTime @default(now())
  batteryPercentage Float    @map("battery_percentage")
  latencyMs         Float    @map("latency_ms")
  diagnosis         String
  confidenceScore   Float    @map("confidence_score")
  boundingBox       Float[]  @map("bounding_box")
  validationStatus  String   @default("pending") @map("validation_status")
  doctorNotes       String?  @map("doctor_notes") @db.Text
  referralIssued    Boolean  @default(false) @map("referral_issued")

  @@map("medical_records")
}